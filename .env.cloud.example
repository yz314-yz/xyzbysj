# 业务前后端端口
FRONTEND_PORT=8080
BACKEND_PORT=3000

# 浏览器访问后端的公网地址。部署到云服务器后改成你的域名或公网 IP。
PUBLIC_API_BASE=http://你的服务器公网IP:3000

# 前端允许访问后端的来源。多个来源用英文逗号分隔。
CORS_ORIGIN=http://你的服务器公网IP:8080

# Qwen3-VL OpenAI 兼容服务地址。
# 如果模型服务和后端在同一台 Docker 网络里，可用 http://qwen3-vl:8000/v1
# 如果模型单独部署在 GPU 云服务器，填写它的公网或内网地址。
OPEN_MODEL_BASE_URL=http://你的GPU服务器IP:8000/v1
OPEN_MODEL_API_KEY=EMPTY
OPEN_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct

# 拉取 Hugging Face 模型时如遇限速或私有模型需要填写。
HUGGING_FACE_HUB_TOKEN=
QWEN_PORT=8000
