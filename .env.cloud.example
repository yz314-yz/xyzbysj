# Business service ports
FRONTEND_PORT=8080
BACKEND_PORT=3000

# Public browser-to-backend address. After cloud deployment, change this to your domain or public IP.
PUBLIC_API_BASE=http://your-server-public-ip:3000

# Allowed frontend origins. Use commas for multiple origins.
CORS_ORIGIN=http://your-server-public-ip:8080

# SQLite persistence and backend runtime settings
DATA_DIR=/app/data
DATABASE_PATH=/app/data/tcm-wellness.sqlite
LOG_DIR=/app/logs
LOG_LEVEL=info
JWT_SECRET=please-change-this-production-secret
JWT_EXPIRES_IN=7d
ENABLE_MERIDIAN_CRON=false
DIAGNOSE_RATE_WINDOW_MS=60000
DIAGNOSE_RATE_MAX=10

# Qwen2.5-VL OpenAI-compatible service.
# If the model service is on the same Docker network, use a value such as http://qwen25-vl:8000/v1.
# If the model service is on a GPU cloud host, use its public or private address.
OPEN_MODEL_BASE_URL=http://your-gpu-server-ip:8000/v1
OPEN_MODEL_API_KEY=
OPEN_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct
OPEN_MODEL_TIMEOUT_MS=30000

# Optional token for model downloads when the GPU model service needs it.
HUGGING_FACE_HUB_TOKEN=
QWEN_PORT=8000

# Optional observability profile: docker compose --profile observability ...
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
LOKI_PORT=3100


