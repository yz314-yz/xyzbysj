PORT=3000
NODE_ENV=development
PUBLIC_API_BASE=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

DATABASE_PATH=./data/tcm-wellness.sqlite
JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=7d

# 答辩演示模式：保持 OPEN_MODEL_BASE_URL 为空即可完全使用本地规则引擎，无需网络模型服务。
OPEN_MODEL_BASE_URL=
OPEN_MODEL_API_KEY=
OPEN_MODEL_NAME=Qwen/Qwen3-VL-32B-Instruct
OPEN_TEXT_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
OPEN_MODEL_TIMEOUT_MS=30000

DIAGNOSE_RATE_WINDOW_MS=60000
DIAGNOSE_RATE_MAX=10
# 公网反向代理/CDN 后建议设为 1；本地直连可设为 false。
TRUST_PROXY=1
LOG_LEVEL=info
ENABLE_MERIDIAN_CRON=false


