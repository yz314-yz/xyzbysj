PORT=3000
NODE_ENV=development
PUBLIC_API_BASE=
CORS_ORIGIN=http://localhost:5173

DATA_DIR=./data
DATABASE_PATH=./data/tcm-wellness.sqlite
LOG_DIR=./logs
LOG_LEVEL=info

JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=7d

# 模式一：公网免费体验版。保持 OPEN_MODEL_BASE_URL 为空；图片在访客浏览器提取轻量特征，后端只接收结构化结果。
# 模式二：离线增强演示版。仅在答辩电脑或完整模型电脑上配置本机 OpenAI 兼容 Qwen3-VL 地址。
OPEN_MODEL_BASE_URL=
OPEN_MODEL_API_KEY=
OPEN_MODEL_NAME=Qwen/Qwen3-VL-32B-Instruct
OPEN_TEXT_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
OPEN_MODEL_TIMEOUT_MS=30000

JSON_BODY_LIMIT=1mb
# 上线严格模式：打开后必须有多模态模型证据才生成方案；演示/开发可设为 false。
REQUIRE_MODEL_EVIDENCE=false
DIAGNOSE_RATE_WINDOW_MS=60000
DIAGNOSE_RATE_MAX=10
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=5
# 公网反向代理/CDN 后建议设为 1；本地直连可设为 false。
TRUST_PROXY=1
ENABLE_MERIDIAN_CRON=false


